{
  "name": "lettrine",
  "version": "0.2.2",
  "private": true,
  "description": "A native Markdown editor for macOS that formats as you type",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/build-native.mjs --run",
    "test": "node --test test/*.test.mjs",
    "test:core": "node --test test/core.test.mjs",
    "test:dom": "node --test test/dom.test.mjs",
    "test:boot": "node --test test/boot.test.mjs",
    "test:editor": "node test/editor.mjs",
    "test:headings": "node test/heading-input.mjs",
    "test:library": "node test/library.mjs",
    "test:features": "node test/features.mjs",
    "test:selection": "node test/math-selection.mjs",
    "test:workspace": "node test/workspace.mjs",
    "test:performance": "node test/performance.mjs",
    "test:native": "node test/native.mjs",
    "test:native:all": "node test/native.mjs --all",
    "test:exports": "node test/native.mjs --exports",
    "test:external-actions": "node test/external-actions.mjs",
    "dist": "node scripts/package-native.mjs",
    "dist:dir": "node scripts/build-native.mjs",
    "release": "node scripts/release.mjs",
    "release:snapshot": "node scripts/release.mjs --snapshot"
  },
  "dependencies": {
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "codemirror": "^5.65.21",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "gemoji": "^8.1.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1"
  }
}
